# Copie ce fichier vers .env en local si besoin.
# Sur Netlify : Site configuration → Environment variables.

# URL publique du site (sans slash final)
BETTER_AUTH_URL=https://nexafly.org

# Secret de session (génère une longue chaîne aléatoire)
BETTER_AUTH_SECRET=

# Postgres (Neon, gratuit). Sans ça, le répertoire s'affiche
# mais les dons et les comptes ne persistent pas.
DATABASE_URL=

# Laisse à true pour les comptes association
VITE_AUTH_ENABLED=true
